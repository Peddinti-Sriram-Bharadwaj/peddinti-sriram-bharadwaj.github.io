{# A tear-off pad: every few seconds the top slip rips away, revealing Voyager 1's new distance. #}
<aside class="voyager" aria-label="Voyager 1's distance from Earth">
  <div class="pad-binding"><span>Voyager 1</span><span>from Earth</span></div>
  <div class="pad-sheets">
    <div class="pad-sheet" data-sheet>
      <div class="pad-line"><span class="pad-num" data-num>—</span><span class="pad-unit">km</span></div>
      <div class="pad-note" data-note>&nbsp;</div>
    </div>
  </div>
</aside>
<script type="module" src="/assets/js/voyager-pad.js"></script>
