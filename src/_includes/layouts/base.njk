<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,500;0,700;0,800;1,500;1,700&family=Alegreya+Sans:ital,wght@0,500;0,600;0,700;1,500&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
<link rel="icon" href="/favicon.png">
</head>
<body id="top">
<a class="skip" href="#main">Skip to content</a>
<div class="wrap">
  {% include "partials/header.njk" %}
</div>
{{ content | safe }}
<div class="wrap">
  {% include "partials/footer.njk" %}
</div>
</body>
</html>
